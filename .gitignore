# Generated at deploy time by .github/workflows/pages.yml (plan §11) and
# fetched at runtime by js/consent.js. Never committed: the SHA and the
# timestamp belong to a deployment, not to the source tree.
release.json

# Weekly pool-health run artifacts that are not the committed state file.
tools/.pool-health-cache.json

# Local agent task briefs — never committed (each self-instructs "do not
# commit"; repo precedent 1f7073c removed the earlier batch before push).
.feat-*.md
